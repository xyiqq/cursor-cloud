{
  "name": "deepseek-harness-desktop",
  "version": "0.4.1",
  "private": true,
  "description": "DeepSeek Harness Windows desktop client (Electron + official dsh)",
  "main": "electron/main.js",
  "author": "DeepSeek Harness Desktop Contributors",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/ensure-win-natives.mjs && node scripts/patch-directory-picker.mjs && node scripts/patch-apiproxy-image-vision.mjs",
    "sync:natives": "node scripts/ensure-win-natives.mjs",
    "patch:picker": "node scripts/patch-directory-picker.mjs",
    "patch:apiproxy": "node scripts/patch-apiproxy-image-vision.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "start": "cross-env ELECTRON_DEV=1 electron .",
    "dist": "npm run sync:natives && npm run patch:picker && npm run patch:apiproxy && npm run verify:runtime && electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "dist:zip": "npm run sync:natives && npm run patch:picker && npm run patch:apiproxy && npm run verify:runtime && electron-builder --win zip --x64"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.6",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.6",
    "@deepseek-ai/dsh-base": "0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-web-app": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.6",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "43.4.0",
    "electron-builder": "^26.0.12"
  }
}
