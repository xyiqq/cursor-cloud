{
  "name": "dsh-plugin-liang-calibrator",
  "version": "1.0.0",
  "description": "滑动变祖器 — liang-intensity-calibrator for DeepSeek Harness. Pick a model from the Model row; the slider only adjusts that model's thinking-effort levels.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "lib/assets/frames/*.webp"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "liang",
    "slider",
    "effort",
    "model-selection"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-model-selection": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
